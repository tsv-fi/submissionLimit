msgid "plugins.generic.submissionLimit.displayName"
msgstr "Submission Limit"

msgid "plugins.generic.submissionLimit.description"
msgstr "Endast webbplatsadministratörer, tidskriftsadministratörer, sektionsredaktörer och assistenter kan skapa nya bidrag med en API-nyckel. Bidrag som skickas in via tidskriftens webbplats påverkas inte."

msgid "plugins.generic.submissionLimit.error.apiKey"
msgstr "Du har inte behörighet att skapa nya bidrag med en API-nyckel."
