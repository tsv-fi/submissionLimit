msgid "plugins.generic.submissionLimit.displayName"
msgstr "Submission Limit"

msgid "plugins.generic.submissionLimit.description"
msgstr "Only site administrators, journal managers, section editors and assistants can create new submissions with an API key. Submissions made through the journal website are not affected."

msgid "plugins.generic.submissionLimit.error.apiKey"
msgstr "You are not allowed to create new submissions with an API key."
